# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/lib/env.ts, exposeEnv=local, auto=not(forEnv(production)))
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=http://localhost:3000

# @type=url
CORS_ORIGIN=http://localhost:3001

# @type=string(minLength=1)
DATABASE_URL=postgresql://postgres:password@localhost:5432/bun-hono-stack

