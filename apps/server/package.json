{
	"name": "@bun-hono-stack/server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bun x auth@latest generate --config src/lib/auth.ts --output ../../packages/db/src/schema/auth.ts --yes"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.22",
		"@better-auth/sso": "1.7.22",
		"@bun-hono-stack/db": "workspace:*",
		"@hono/zod-validator": "^0.9.1",
		"better-auth": "catalog:",
		"drizzle-orm": "catalog:",
		"hono": "^4.13.18",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"tsdown": "^0.23.7",
		"typescript": "catalog:"
	},
	"exports": {
		".": "./src/index.ts"
	}
}
