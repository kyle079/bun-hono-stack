{
	"name": "bun-hono-stack",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.6.7",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.4",
			"varlock": "1.25.0",
			"better-auth": "1.7.22",
			"lucide-react": "^1.72.0",
			"next-themes": "^0.4.6",
			"react": "^19.3.1",
			"react-dom": "^19.3.1",
			"sonner": "^2.0.8",
			"@types/react": "^19.3.0",
			"@types/react-dom": "^19.3.0",
			"tailwindcss": "^4.3.5",
			"drizzle-orm": "1.0.0-rc.5"
		}
	},
	"type": "module",
	"bun-create": {
		"postinstall": "bun scripts/rename.ts",
		"start": "bun run dev"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F @bun-hono-stack/web --",
		"dev:server": "turbo run dev -F @bun-hono-stack/server --",
		"db:push": "turbo run db:push -F @bun-hono-stack/db --",
		"db:studio": "turbo run db:studio -F @bun-hono-stack/db --",
		"db:generate": "turbo run db:generate -F @bun-hono-stack/db --",
		"db:migrate": "turbo run db:migrate -F @bun-hono-stack/db --",
		"db:start": "turbo run db:start -F @bun-hono-stack/db --",
		"db:watch": "turbo run db:watch -F @bun-hono-stack/db --",
		"db:stop": "turbo run db:stop -F @bun-hono-stack/db --",
		"db:down": "turbo run db:down -F @bun-hono-stack/db --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "turbo run auth:generate -F @bun-hono-stack/server --",
		"check": "biome check --write .",
		"check:ci": "biome ci .",
		"test": "bun test"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@types/bun": "catalog:",
		"turbo": "^2.11.11",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.5"
}
