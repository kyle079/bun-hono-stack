# registered at runtime through the SSO plugin API.
# @optional @type=string
SSO_PROVIDER_ID=

# @optional @type=string
SSO_DOMAIN=

# @optional @type=url
SSO_ISSUER=

# @optional @type=string
SSO_CLIENT_ID=

# @optional @type=string
SSO_CLIENT_SECRET=
